{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unlibra-com",
  "compatibility_date": "2026-10-19",
  // Static Assets only: no Worker script ("main")
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
