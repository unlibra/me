{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unlibra-com",
  "compatibility_date": "2026-10-19",
  // Served only on the custom domain: no workers.dev URL and no Version
  // (preview) URLs, which would show the same site at a second address.
  // Both are written here because a setting left out keeps the one already
  // set on Cloudflare (docs/deploy.md).
  "workers_dev": false,
  "preview_urls": false,
  // Static Assets only: no Worker script ("main")
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
