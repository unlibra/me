---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";

const heading = "ページが見つかりません / Page not found";
---

<BaseLayout
  lang="ja"
  title={`${heading} - ${site.title}`}
  description={heading}
  canonical={false}
>
  <main class="mx-auto max-w-3xl px-4 py-16 text-center">
    <h1 class="text-2xl font-bold">ページが見つかりません</h1>
    <p class="mt-2 text-neutral-500" lang="en">
      Page not found
    </p>
    <p class="mt-8">
      <a href="/" class="underline">
        トップへ戻る / Back to top
      </a>
    </p>
  </main>
</BaseLayout>
