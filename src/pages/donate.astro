---
// Donate: Japanese only, like the privacy policy and the credits. Donations
// come as Amazon e-gift cards sent to the address in src/config/site.ts.
import ArrowUpRightIcon from "@/components/icons/ArrowUpRightIcon.astro";
import DonateCopyButton from "@/components/donate/donate-copy-button";
import MarkdownLayout from "@/layouts/MarkdownLayout.astro";
import { site } from "@/config/site";

const { email, amazonGift } = site.donation;

const frontmatter = {
  title: "寄付・支援",
  description:
    "unlibra への寄付・支援のご案内です。Amazonギフトカードで寄付を受け付けています。",
};

const focus =
  "outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500";
---

<MarkdownLayout frontmatter={frontmatter}>
  <h1>寄付・支援</h1>
  <p>
    活動を応援していただける方は、Amazonギフトカードで寄付をお送りください。
  </p>
  <p>
    受取人のメールアドレスに下のアドレスを入力して、ギフトカードを贈ってください。金額は自由です。
  </p>

  <!-- The address in the password generator's field, with its copy button
       (src/components/ui/copy-button.tsx). The address is text only, never
       in an attribute, so that Cloudflare's Email Address Obfuscation can
       hide it from scrapers. -->
  <div class="relative mt-6 overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-600 dark:bg-atom-one-dark-light">
    <div
      class="w-full truncate bg-transparent py-3 pr-28 pl-4 font-mono text-base text-gray-900 outline-hidden dark:text-gray-100"
      data-donate-email
    >
      {email}
    </div>
    <DonateCopyButton
      client:load
      label="メールアドレスをクリップボードにコピー"
      failed="コピーに失敗しました"
    />
  </div>

  <p class="mt-6">
    <a
      href={amazonGift}
      target="_blank"
      rel="noopener noreferrer"
      class={`inline-flex items-center gap-1 rounded-md bg-link px-4 py-2 text-base font-medium text-white motion-safe:transition-colors hover:bg-link-hover dark:bg-primary-light dark:text-gray-900 dark:hover:bg-link-dark-hover ${focus}`}
      data-button
    >
      Amazonギフトカードを贈る
      <ArrowUpRightIcon class="size-4" />
    </a>
  </p>
</MarkdownLayout>
