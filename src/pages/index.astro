---
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import ShoppingBagIcon from "@/components/icons/ShoppingBagIcon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WorkList from "@/components/works/WorkList.astro";
import messages from "@/messages/ja";
import { site } from "@/config/site";
import { categories, works } from "@/config/works";

const sections = categories.map((category) => ({
  category,
  label: messages.categories[category],
  works: works.filter((work) => work.category === category),
}));

const heroLinks = [
  { href: site.links.github, label: messages.hero.github, Icon: GitHubIcon },
  // A generic icon, not BOOTH's logo (which may not be changed); Lucide's
  // shopping-bag until the owner chooses one on /mock/booth-icons.
  { href: site.links.booth, label: messages.hero.booth, Icon: ShoppingBagIcon },
];

const link =
  "outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500";
---

<BaseLayout
  lang="ja"
  title={site.title}
  description={messages.site.description}
  canonical={true}
>
  <main class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8">
    <!-- Hero with the wave background of the former tool site -->
    <div class="relative -mt-6 mb-12 sm:mb-16" data-hero>
      <!-- Wave background: full width, behind the header and below -->
      <div class="absolute -top-24 -bottom-10 left-1/2 -z-10 w-screen -translate-x-1/2 overflow-hidden sm:-bottom-24 xl:-bottom-32">
        <div class="absolute inset-0 border-b border-transparent bg-linear-to-b/srgb from-white/0 from-3% via-logo-light/60 to-logo-medium/80 dark:from-atom-one-dark/0 dark:from-3% dark:via-[#999999]/20 dark:to-[#CFCFCF]/20"></div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 1440 320"
          class="absolute bottom-0 h-20 w-full sm:h-48 xl:h-64"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M0,64L48,90.7C96,117,192,171,288,192C384,213,480,203,576,181.3C672,160,768,128,864,149.3C960,171,1056,245,1152,261.3C1248,277,1344,235,1392,213.3L1440,192L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"
            class="fill-white dark:fill-atom-one-dark"
          ></path>
        </svg>
      </div>

      <!-- Hero content -->
      <div class="relative mx-auto max-w-screen-sm pt-12 pb-20 text-center">
        <h1 class="mb-8 text-2xl font-semibold">{messages.hero.title}</h1>
        <!-- Text buttons: the logo and the text (ui-revise5 1, pattern A of
             ui-revise4 1). -->
        <ul class="flex flex-wrap justify-center gap-2" data-hero-links>
          {heroLinks.map(({ href, label, Icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-semibold text-gray-900 hover:underline dark:text-white ${link}`}
              >
                <Icon class="size-4" />
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Works by category: 24px further from the hero's wave (ui-revise5 3) -->
    <div class="mb-12 space-y-12 pt-6" data-works>
      {sections.map(({ category, label, works }) => (
        <section
          id={category}
          aria-labelledby={`${category}-heading`}
          class="scroll-mt-4"
        >
          <h2 id={`${category}-heading`} class="mb-4 text-2xl font-semibold">
            {label}
          </h2>
          <WorkList category={category} works={works} />
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
