---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Avatar from "@/components/Avatar.astro";
import SponsorButton from "@/components/SponsorButton.astro";
import WorkCard from "@/components/WorkCard.astro";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import messages from "@/messages/ja";
import { layoutMessages } from "@/messages/layout";
import { site } from "@/config/site";
import { profile } from "@/config/profile";
import { categories, works } from "@/config/works";

const sections = categories.map((category) => ({
  category,
  label: messages.categories[category],
  works: works.filter((work) => work.category === category),
}));

const link =
  "outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500";
---

<BaseLayout
  lang="ja"
  title={site.title}
  description={messages.site.description}
  canonical={true}
>
  <main class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <!-- Profile -->
    <section class="flex flex-col items-center gap-4 py-12 text-center sm:py-16">
      <div class="size-24 overflow-hidden rounded-full sm:size-28">
        <Avatar class="size-full" />
      </div>
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-white">
        {profile.name}
      </h1>
      <p class="max-w-xl">{messages.profile.bio}</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class={`inline-flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2 font-medium transition-colors hover:bg-black/5 dark:border-gray-600 dark:hover:bg-white/5 ${link}`}
        >
          <GitHubIcon class="size-5" />
          {layoutMessages.ja.header.github}
        </a>
        <SponsorButton href={site.links.sponsor} />
      </div>
    </section>

    <!-- Links to each category -->
    <nav aria-label={messages.categoryNav} class="mb-12">
      <ul class="flex flex-wrap justify-center gap-2">
        {sections.map(({ category, label }) => (
          <li>
            <a
              href={`#${category}`}
              class={`block rounded-full bg-gray-100 px-4 py-2 text-sm font-medium transition-colors hover:bg-gray-200 dark:bg-atom-one-dark-light dark:hover:bg-atom-one-dark-lighter ${link}`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Works by category -->
    <div class="space-y-16">
      {sections.map(({ category, label, works }) => (
        <section
          id={category}
          aria-labelledby={`${category}-heading`}
          class="scroll-mt-4"
        >
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
            <h2
              id={`${category}-heading`}
              class="text-2xl font-semibold text-gray-900 dark:text-white"
            >
              {label}
            </h2>
            {category === "vrchat" && (
              <a
                href={site.links.booth}
                target="_blank"
                rel="noopener noreferrer"
                class={`text-sm text-blue-700 underline underline-offset-4 hover:text-blue-500 dark:text-blue-300 ${link}`}
              >
                {messages.links.shop}
              </a>
            )}
          </div>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {works.map((work) => (
              <WorkCard work={work} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
