---
import { serializeJsonLd } from "./json-ld";

// The separator icon is Heroicons v2.2.0 "chevron-right" (24 outline).
// MIT License, Copyright (c) Tailwind Labs, Inc.

interface BreadcrumbItem {
  label: string;
  /** Site-relative path. The current page (last item) has none. */
  href?: `/${string}`;
}

interface Props {
  items: BreadcrumbItem[];
  /** Origin used to make absolute URLs for the structured data. */
  siteUrl: string;
}

const { items, siteUrl } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href && { item: `${siteUrl}${item.href}` }),
  })),
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={serializeJsonLd(structuredData)}
/>
<nav
  class="mb-6 flex min-w-0 items-center gap-2 text-sm"
  aria-label="Breadcrumb"
>
  {items.map((item, index) => (
    <div class="flex min-w-0 items-center gap-2">
      {index > 0 && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-4 shrink-0 text-gray-600 dark:text-gray-400"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m8.25 4.5 7.5 7.5-7.5 7.5"
          />
        </svg>
      )}
      {item.href ? (
        <a
          href={item.href}
          class="truncate leading-none font-medium text-blue-600 outline-hidden transition-colors hover:text-blue-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 dark:text-blue-400 dark:hover:text-blue-300"
        >
          {item.label}
        </a>
      ) : (
        <span
          class="truncate leading-none font-medium text-gray-600 dark:text-gray-400"
          aria-current="page"
        >
          {item.label}
        </span>
      )}
    </div>
  ))}
</nav>
