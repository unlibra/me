---
import WorldIcon from "@/components/icons/WorldIcon.astro";
import { locales, type Locale } from "@/config/locales";
import type { SitePath } from "@/config/site";
import { layoutMessages, localeNames } from "@/messages/layout";

interface Props {
  lang: Locale;
  /** Paths of this page in each language. */
  paths: Record<Locale, SitePath>;
}

const { lang, paths } = Astro.props;
const t = layoutMessages[lang].language;
---

<div class="relative" data-popover data-language-switcher>
  <button
    type="button"
    class="flex cursor-pointer items-center justify-center gap-2 rounded-full p-2.5 min-h-11 min-w-11 transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    aria-label={t.toggle}
    aria-expanded="false"
    aria-controls="language-menu"
    data-popover-button
  >
    <WorldIcon class="size-5" />
    <span class="mr-1 hidden text-base font-medium sm:block">{t.label}</span>
  </button>
  <div
    id="language-menu"
    class="absolute right-0 z-50 mt-2 w-32 overflow-hidden rounded-lg border border-gray-200 bg-white p-1 shadow-lg dark:border-gray-700 dark:bg-atom-one-dark-light"
    data-popover-panel
    hidden
  >
    {locales.map((locale) => (
      <a
        href={paths[locale]}
        hreflang={locale}
        lang={locale}
        aria-current={locale === lang ? "page" : undefined}
        class="flex w-full items-center gap-2 rounded-lg px-3 py-2.5 text-left text-base transition-colors outline-none hover:bg-gray-100 focus-visible:bg-gray-100 aria-[current=page]:bg-primary/10 dark:hover:bg-atom-one-dark-lighter dark:focus-visible:bg-atom-one-dark-lighter dark:aria-[current=page]:bg-atom-one-dark-lighter"
        data-popover-item
      >
        {localeNames[locale]}
      </a>
    ))}
  </div>
</div>

<script>
  import { setupPopover } from "@/scripts/popover";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-language-switcher]",
  )) {
    setupPopover(root);
  }
</script>
