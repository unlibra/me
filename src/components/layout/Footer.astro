---
// Footer: the layout of the former tool site's footer.
import BrandSymbol from "@/components/BrandSymbol.astro";
import type { Locale } from "@/config/locales";
import { copyrightNotice, paths, site } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = layoutMessages[lang].footer;
const link =
  "text-sm text-gray-600 transition-all hover:underline dark:text-gray-400";
const heading = "mb-3 text-sm font-semibold tracking-wider uppercase";

// The build year ends the copyright notice (design doc 3.7).
const copyright = copyrightNotice(new Date().getFullYear());

const externalLinks = [
  { href: site.links.github, label: t.github },
  { href: site.links.docs, label: t.docs },
  { href: site.links.booth, label: t.shop },
];
---

<footer class="bg-gray-100 py-12 dark:bg-atom-one-dark-light">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_2fr_1fr] lg:gap-12">
      <!-- Left: logo and site name -->
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 transition-all hover:underline"
        >
          <BrandSymbol class="size-6" />
          <span class="text-xl font-semibold">{site.title}</span>
        </a>
        <p class="mt-3 text-sm whitespace-pre-line text-gray-600 dark:text-gray-400">
          {t.description}
        </p>
      </div>

      <!-- Center: links (where the former site listed the tools) -->
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        <div data-footer-links>
          <h2 class={heading}>{t.links}</h2>
          <ul class="space-y-2">
            {externalLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={link}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Right: support -->
      <div>
        <h2 class={heading}>{t.support}</h2>
        <ul class="space-y-2">
          <li>
            <a
              href={site.links.sponsor}
              target="_blank"
              rel="noopener noreferrer"
              class={link}
            >
              {t.donate}
            </a>
          </li>
          <li>
            <a href={paths.privacy} class={link}>
              {t.privacyPolicy}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-8 text-sm text-gray-600 dark:text-gray-400">{copyright}</p>
  </div>
</footer>
