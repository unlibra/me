---
import SymbolIcon from "@/assets/brand/symbol.svg";
import GitHubIcon from "@/components/icons/GitHubIcon.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import type { Locale } from "@/config/locales";
import { paths, site, type SitePath } from "@/config/site";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
  /** Paths of this page in each language, when it has both. */
  languagePaths?: Record<Locale, SitePath>;
}

const { lang, languagePaths } = Astro.props;
const t = layoutMessages[lang].header;
const iconButton =
  "flex items-center justify-center rounded-full p-2 transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5";
---

<header>
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="flex items-center gap-2 outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500"
    >
      <SymbolIcon class="size-6" aria-hidden="true" />
      <span class="text-xl font-semibold">{site.title}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <a
        href={paths.tools[lang]}
        class="rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors outline-none hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
      >
        {t.tools}
      </a>
      <a
        href={site.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class={iconButton}
        aria-label={t.github}
      >
        <GitHubIcon class="size-5" />
      </a>
      {languagePaths && <LanguageSwitcher lang={lang} paths={languagePaths} />}
      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>
