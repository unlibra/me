---
// A list item for Apps and Libraries: the former tool site's card (its hover,
// padding and icon background), with the icon beside the text so that the
// row reads as one work, and the title, the summary, the year and the links
// of every card (ui-revise3 3).
import CardLinks from "@/components/works/CardLinks.astro";
import OpenDetails from "@/components/works/OpenDetails.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import {
  cardRadius,
  cardSummary,
  cardTitle,
  listHover,
} from "@/components/works/card-classes";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<article
  class:list={["group relative flex gap-4 p-4", cardRadius, listHover]}
  data-work={work.id}
  data-card="tool"
>
  <WorkIcon work={work} size="size-12" />
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class:list={["text-lg", cardTitle]} data-work-title>
        <OpenDetails work={work} />
      </h3>
      <time
        datetime={work.year}
        class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
      >
        {work.year}
      </time>
    </div>
    <p class={cardSummary} data-work-summary>
      {messages.works[work.id].summary}
    </p>
    <CardLinks work={work} class="mt-auto" />
  </div>
</article>
