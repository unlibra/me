---
// A list item for Apps and Libraries: the former tool site's card (its hover,
// padding and icon background), with the icon beside the text so that the
// row reads as one work (ui-revise3 3). The whole card links to the work
// (ui-revise4 2).
import CardLinks from "@/components/works/CardLinks.astro";
import CardTitle from "@/components/works/CardTitle.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import {
  cardHover,
  cardRadius,
  cardSummary,
  cardTitle,
} from "@/components/works/card-classes";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<article
  class:list={["group relative flex gap-4 p-4", cardRadius, cardHover]}
  data-work={work.id}
  data-card="tool"
>
  <WorkIcon work={work} size="size-12" />
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <h3 class:list={["text-lg", cardTitle]} data-work-title>
      <CardTitle work={work} />
    </h3>
    <p class={cardSummary} data-work-summary>
      {messages.works[work.id].summary}
    </p>
    <CardLinks work={work} class="mt-auto" />
  </div>
</article>
