---
// A work's details in a modal <dialog>, opened by its card's button. Esc
// (native), the close button and a click on the backdrop close it.
import { Image } from "astro:assets";

import XMarkIcon from "@/components/icons/XMarkIcon.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import { subcategoryChip } from "@/components/works/card-classes";
import { dialogId, dialogTitleId } from "@/components/works/ids";
import { linksOf } from "@/components/works/work-links";
import { isPhoto, photoPosition } from "@/config/cards";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, description } = messages.works[work.id];
const photo = isPhoto(work.category);
const links = linksOf(work);
const focusRing =
  "outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500";
---

<dialog
  id={dialogId(work)}
  aria-labelledby={dialogTitleId(work)}
  class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-xl bg-white p-0 text-gray-700 shadow-xl backdrop:bg-black/60 dark:bg-atom-one-dark-deep dark:text-gray-300"
  data-work-dialog={work.id}
>
  <!-- Outside the scrolling area, so that it stays in view. -->
  <button
    type="button"
    aria-label={messages.workDetails.close}
    class={`absolute top-3 right-3 z-10 flex size-9 cursor-pointer items-center justify-center rounded-full bg-black/50 text-white hover:bg-black/70 ${focusRing}`}
    data-work-close
  >
    <XMarkIcon class="size-5" />
  </button>
  <div class="relative max-h-[calc(100dvh-2rem)] overflow-y-auto">
    {photo ? (
      <div class="aspect-4/3 overflow-hidden bg-gray-100 sm:aspect-video dark:bg-atom-one-dark-light">
        <Image
          src={work.image}
          alt={title}
          class:list={["size-full object-cover", photoPosition(work)]}
        />
      </div>
    ) : (
      <div class="flex justify-center bg-gray-100 py-10 dark:bg-atom-one-dark-light">
        <WorkIcon work={work} size="size-24" />
      </div>
    )}
    <div class="space-y-3 p-5 sm:p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2
          id={dialogTitleId(work)}
          class="text-xl font-semibold text-gray-900 dark:text-white"
        >
          {title}
        </h2>
        <time
          datetime={work.year}
          class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
        >
          {work.year}
        </time>
      </div>
      {work.subcategory && (
        <p class={subcategoryChip}>
          {messages.vr3dSubcategories[work.subcategory]}
        </p>
      )}
      <p
        class="text-sm leading-relaxed whitespace-pre-line text-gray-600 dark:text-gray-400"
        data-work-description
      >
        {description}
      </p>
      {links.length > 0 && (
        <ul class="flex flex-wrap gap-2 pt-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class={`inline-block rounded-md bg-logo-dark px-3 py-1.5 text-sm font-medium text-white hover:bg-logo-medium ${focusRing}`}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</dialog>
