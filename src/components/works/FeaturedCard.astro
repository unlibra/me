---
// A featured work (`featured: true`): a full-width card with the image and
// the summary side by side.
import { Image } from "astro:assets";

import MoreLabel from "@/components/works/MoreLabel.astro";
import OpenDetails from "@/components/works/OpenDetails.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import { liftOnHover, subcategoryChip } from "@/components/works/card-classes";
import { isPhoto } from "@/config/cards";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, summary } = messages.works[work.id];
const photo = isPhoto(work.category);
---

<article
  class:list={[
    "group relative col-span-full grid overflow-hidden rounded-xl border border-gray-200 hover:border-gray-300 md:grid-cols-2 dark:border-atom-one-dark-lighter dark:hover:border-gray-600",
    liftOnHover,
  ]}
  data-work={work.id}
  data-subcategory={work.subcategory}
  data-card="featured"
>
  <div class="flex aspect-4/3 items-center justify-center overflow-hidden bg-gray-100 dark:bg-atom-one-dark-light">
    {photo ? (
      <Image
        src={work.image}
        alt={title}
        class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
      />
    ) : (
      <WorkIcon work={work} size="size-28" />
    )}
  </div>
  <div class="flex flex-col justify-center gap-3 p-5 sm:p-8">
    <p class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <time datetime={work.year}>{work.year}</time>
      {work.subcategory && (
        <span class={subcategoryChip}>
          {messages.vr3dSubcategories[work.subcategory]}
        </span>
      )}
    </p>
    <h3 class="text-2xl font-semibold text-gray-900 sm:text-3xl dark:text-white">
      <OpenDetails work={work} />
    </h3>
    <p class="text-gray-600 dark:text-gray-400" data-work-summary>
      {summary}
    </p>
    <MoreLabel />
  </div>
</article>
