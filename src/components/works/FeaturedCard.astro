---
// A featured work (`featured: true`): a full-width card with the image and
// the summary side by side, without a border (ui-revise5 12). "SPOTLIGHT"
// is above the title, in text-4xl (ui-revise5 13).
import { Image } from "astro:assets";

import CardLinks from "@/components/works/CardLinks.astro";
import CardTitle from "@/components/works/CardTitle.astro";
import WorkIcon from "@/components/works/WorkIcon.astro";
import {
  cardHover,
  cardRadius,
  cardSummary,
  cardTitle,
} from "@/components/works/card-classes";
import { isPhoto, photoPosition } from "@/config/cards";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
// The photo is decorative: the title is the heading next to it.
const { summary } = messages.works[work.id];
const photo = isPhoto(work.category);
---

<article
  class:list={[
    "group relative col-span-full grid overflow-hidden md:grid-cols-2",
    cardRadius,
    cardHover,
  ]}
  data-work={work.id}
  data-card="featured"
>
  <div class="flex aspect-4/3 items-center justify-center overflow-hidden bg-gray-100 dark:bg-atom-one-dark-light">
    {photo ? (
      <Image
        src={work.image}
        alt=""
        class:list={["size-full object-cover", photoPosition(work)]}
      />
    ) : (
      <WorkIcon work={work} size="size-28" />
    )}
  </div>
  <div class="flex flex-col justify-center gap-4 p-6 sm:p-8">
    <p
      class="text-sm font-semibold tracking-widest text-gray-500 dark:text-gray-400"
      data-work-spotlight
    >
      {messages.workDetails.spotlight}
    </p>
    <h3 class:list={["text-4xl", cardTitle]} data-work-title>
      <CardTitle work={work} />
    </h3>
    <p class={cardSummary} data-work-summary>
      {summary}
    </p>
    <CardLinks work={work} />
  </div>
</article>
