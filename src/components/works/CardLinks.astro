---
// The links at the end of a card: the work's actions, which go to the place
// directly (in front of the title button's overlay, so that a click on them
// does not open the details), then "詳しく見る".
import ChevronRightIcon from "@/components/icons/ChevronRightIcon.astro";
import MoreLabel from "@/components/works/MoreLabel.astro";
import {
  cardLink,
  cardLinkChevron,
  focusRing,
} from "@/components/works/card-classes";
import { cardTitleId } from "@/components/works/ids";
import { cardActionsOf } from "@/components/works/work-links";
import type { Work } from "@/config/works";

interface Props {
  work: Work;
  class?: string;
}

const { work, class: className } = Astro.props;
const actions = cardActionsOf(work);
---

<div
  class:list={["flex flex-wrap items-center gap-x-4 gap-y-2", className]}
  data-work-links
>
  {actions.map((action) => (
    <a
      href={action.href}
      target={action.external ? "_blank" : undefined}
      rel={action.external ? "noopener noreferrer" : undefined}
      aria-describedby={cardTitleId(work)}
      class={`group/link relative z-10 rounded-sm hover:underline ${cardLink} ${focusRing}`}
      data-work-action
    >
      {action.label}
      <ChevronRightIcon class={cardLinkChevron} />
    </a>
  ))}
  <MoreLabel work={work} />
</div>
