---
// "詳しく見る" with a chevron, at the end of every card: says that a click
// opens the details. It is part of the card button's name (aria-labelledby),
// so that voice control can use the visible words; it is hidden from screen
// readers here so that it is not read twice.
import ChevronRightIcon from "@/components/icons/ChevronRightIcon.astro";
import { cardLink, moreChevron } from "@/components/works/card-classes";
import { moreLabelId } from "@/components/works/ids";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<p
  id={moreLabelId(work)}
  class={`group-hover:underline ${cardLink}`}
  aria-hidden="true"
  data-work-more
>
  {messages.workDetails.more}
  <ChevronRightIcon class={moreChevron} />
</p>
