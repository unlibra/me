---
// One frame for the photo categories (DIY Keyboards, VR & 3D): a 4:3 photo,
// the title, the year and the summary.
import { Image } from "astro:assets";

import MoreLabel from "@/components/works/MoreLabel.astro";
import OpenDetails from "@/components/works/OpenDetails.astro";
import { liftOnHover, subcategoryChip } from "@/components/works/card-classes";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
// The photo is decorative: the title is the heading next to it.
const { summary } = messages.works[work.id];
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-lg border border-gray-200 hover:border-gray-300 dark:border-atom-one-dark-lighter dark:hover:border-gray-600",
    liftOnHover,
  ]}
  data-work={work.id}
  data-subcategory={work.subcategory}
  data-card="frame"
>
  <div class="aspect-4/3 overflow-hidden bg-gray-100 dark:bg-atom-one-dark-light">
    <Image
      src={work.image}
      alt=""
      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
    />
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-semibold text-gray-900 dark:text-white">
        <OpenDetails work={work} />
      </h3>
      <time
        datetime={work.year}
        class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
      >
        {work.year}
      </time>
    </div>
    {work.subcategory && (
      <p class={subcategoryChip}>
        {messages.vr3dSubcategories[work.subcategory]}
      </p>
    )}
    <p class="text-sm text-gray-600 dark:text-gray-400" data-work-summary>
      {summary}
    </p>
    <MoreLabel work={work} class="mt-auto pt-1" />
  </div>
</article>
