---
// One frame for the photo categories (DIY Keyboards, VR & 3D): a 4:3 photo,
// the title, the year, the summary and the links.
import { Image } from "astro:assets";

import CardLinks from "@/components/works/CardLinks.astro";
import OpenDetails from "@/components/works/OpenDetails.astro";
import {
  cardRadius,
  cardSummary,
  cardTitle,
  liftOnHover,
  subcategoryChip,
} from "@/components/works/card-classes";
import { photoPosition } from "@/config/cards";
import type { Work } from "@/config/works";
import messages from "@/messages/ja";

interface Props {
  work: Work;
}

const { work } = Astro.props;
// The photo is decorative: the title is the heading next to it.
const { summary } = messages.works[work.id];
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden border border-gray-200 hover:border-gray-300 dark:border-atom-one-dark-lighter dark:hover:border-gray-600",
    cardRadius,
    liftOnHover,
  ]}
  data-work={work.id}
  data-subcategory={work.subcategory}
  data-card="frame"
>
  <div class="aspect-4/3 overflow-hidden bg-gray-100 dark:bg-atom-one-dark-light">
    <Image
      src={work.image}
      alt=""
      class:list={[
        "size-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none",
        photoPosition(work),
      ]}
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class:list={["text-lg", cardTitle]} data-work-title>
        <OpenDetails work={work} />
      </h3>
      <time
        datetime={work.year}
        class="shrink-0 text-sm text-gray-500 dark:text-gray-400"
      >
        {work.year}
      </time>
    </div>
    {work.subcategory && (
      <p class={subcategoryChip}>
        {messages.vr3dSubcategories[work.subcategory]}
      </p>
    )}
    <p class={cardSummary} data-work-summary>
      {summary}
    </p>
    <CardLinks work={work} class="mt-auto" />
  </div>
</article>
