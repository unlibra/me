---
import ToolCard from "@/components/lab/ToolCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/config/locales";
import { paths, site } from "@/config/site";
import { toolIds } from "@/config/tools";
import { labMessages } from "@/messages/lab";
import { layoutMessages } from "@/messages/layout";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const heading = layoutMessages[lang].header.tools;
---

<BaseLayout
  lang={lang}
  title={`${heading} - ${site.title}`}
  description={labMessages[lang].description}
  canonical={true}
  alternatePath={paths.tools[lang === "ja" ? "en" : "ja"]}
>
  <main class="mx-auto w-full max-w-7xl px-4 pt-8 pb-12 sm:px-6 lg:px-8">
    <h1 class="mb-4 text-2xl font-semibold">{heading}</h1>
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
      {toolIds.map((tool) => (
        <ToolCard lang={lang} tool={tool} />
      ))}
    </div>
  </main>
</BaseLayout>
