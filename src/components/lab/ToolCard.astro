---
import { Image } from "astro:assets";

import type { Locale } from "@/config/locales";
import { toolIcons, toolPath, type ToolId } from "@/config/tools";
import { toolMessages } from "@/tools/messages";

interface Props {
  lang: Locale;
  tool: ToolId;
}

const { lang, tool } = Astro.props;
const { name, shortDescription } = toolMessages[lang].tools[tool];
---

<a
  href={toolPath(tool, lang)}
  class="group flex w-full flex-col gap-2 rounded-lg p-4 text-left outline-hidden transition-colors hover:bg-gray-100 focus-visible:bg-gray-100 dark:hover:bg-atom-one-dark-light dark:focus-visible:bg-atom-one-dark-light"
  data-tool={tool}
>
  <div class="flex items-center gap-3">
    <div class="relative flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-logo-medium/70">
      <Image src={toolIcons[tool]} alt="" width={40} height={40} />
    </div>
    <h2 class="font-semibold">{name}</h2>
  </div>
  <p class="text-sm text-gray-600 dark:text-gray-400">{shortDescription}</p>
</a>
