---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
if (!frontmatter.title || !frontmatter.description) {
  throw new Error(
    `${Astro.url.pathname}: frontmatter needs both "title" and "description".`,
  );
}
const siteTitle = `${frontmatter.title} - ${site.title}`;
---

<BaseLayout
  lang="ja"
  title={siteTitle}
  description={frontmatter.description}
  canonical={true}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <main class="prose max-w-none">
      <slot />
    </main>
    <footer class="mt-12 border-t border-neutral-200 pt-8 text-center text-sm text-neutral-500">
      <a href="/" class="hover:underline">
        {site.title}
      </a>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  .prose h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.75;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .prose li {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .prose a {
    color: #3ba0be;
    text-decoration: underline;
  }

  .prose a:hover {
    color: #1a7ba0;
  }
</style>
