---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
if (!frontmatter.title || !frontmatter.description) {
  throw new Error(
    `${Astro.url.pathname}: frontmatter needs both "title" and "description".`,
  );
}
const siteTitle = `${frontmatter.title} - ${site.title}`;
---

<BaseLayout
  lang="ja"
  title={siteTitle}
  description={frontmatter.description}
  canonical={true}
>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <main class="prose max-w-none">
      <slot />
    </main>
  </div>
</BaseLayout>

<style is:global>
  /*
   * Line heights (ui-revise7 5, 6): the size times the DADS ratio, rounded
   * up to a multiple of 4px. Headings 1.5 (32px -> 48px, 24px -> 36px,
   * 20px -> 32px); the text to read, paragraphs and list items, 1.7
   * (16px -> 28px).
   */
  .prose h1 {
    font-size: 2rem;
    line-height: 3rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    font-size: 1.5rem;
    line-height: 2.25rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.25rem;
    line-height: 2rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.75rem;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose ul {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .prose li {
    line-height: 1.75rem;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  /*
   * Links: at least 4.5:1 with the page's background, at rest and on hover
   * (final-review 7). Light on white: card-link 5.1:1, hover 7.3:1. Dark on
   * atom-one-dark: logo-light 7.0:1, hover (lighter) 9.7:1.
   */
  .prose a {
    color: #19779b; /* card-link */
    text-decoration: underline;
  }

  .prose a:hover {
    color: #135d79;
  }

  .dark .prose a {
    color: #5bc5dc; /* logo-light */
  }

  .dark .prose a:hover {
    color: #a5e1ee;
  }
</style>
